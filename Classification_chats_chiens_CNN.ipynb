   "source": [
    "## 11. Extension — Transfer learning avec MobileNetV2\n",
    "\n",
    "On propose le **transfer learning** : une dorsale MobileNetV2 pré-entraînée (ImageNet), figée,\n",
    "plus une petite tête de classification. Bénéfice : des caractéristiques de bas niveau (contours,\n",
    "textures) déjà apprises → meilleure précision avec peu d'entraînement."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4114b3f7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# MobileNetV2 attend des images >= 32x32, 3 canaux ; on peut augmenter la résolution ici\n",
    "TL_SIZE = 96\n",
    "tl_train = train_gen.flow_from_dataframe(\n",
    "    df_tr, x_col=\"filepath\", y_col=\"label\", target_size=(TL_SIZE, TL_SIZE),\n",
    "    class_mode=\"binary\", batch_size=batch_size, shuffle=True, seed=seed, validate_filenames=False)\n",
    "tl_val = val_gen.flow_from_dataframe(\n",
    "    df_val, x_col=\"filepath\", y_col=\"label\", target_size=(TL_SIZE, TL_SIZE),\n",
    "    class_mode=\"binary\", batch_size=batch_size, shuffle=False, validate_filenames=False)\n",
    "\n",
    "base = tf.keras.applications.MobileNetV2(\n",
    "    input_shape=(TL_SIZE, TL_SIZE, 3), include_top=False, weights=\"imagenet\")\n",
    "base.trainable = False   # dorsale figée\n",
    "\n",
    "tl_model = models.Sequential([\n",
    "    base,\n",
    "    layers.GlobalAveragePooling2D(),\n",
    "    layers.Dropout(0.3),\n",
    "    layers.Dense(1, activation=\"sigmoid\"),\n",
    "])\n",
    "tl_model.compile(optimizer=tf.keras.optimizers.Adam(1e-3),\n",
    "                 loss=\"binary_crossentropy\", metrics=[\"accuracy\"])\n",
    "tl_history = tl_model.fit(tl_train, validation_data=tl_val, epochs=10,\n",
    "                          callbacks=callbacks, verbose=1)\n",
    "\n",
    "tl_loss, tl_acc = tl_model.evaluate(tl_val, verbose=0)\n",
    "print(f\"MobileNetV2 (transfer) — val_accuracy: {tl_acc:.4f}\")"
   ]
